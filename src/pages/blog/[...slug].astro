---
import { getEntry, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { isPublishedPost } from '../../utils/blogPosts';

const slug = Astro.params.slug;
const post = slug ? await getEntry('blog', slug) : undefined;

if (!post || !isPublishedPost(post)) {
	Astro.response.status = 404;
}

const author = post ? await getEntry('authors', post.data.author) : undefined;
if (post && !author) {
	throw new Error(`Author profile not found: ${post.data.author}`);
}
const { Content } = post ? await render(post) : { Content: undefined };
---

{
	post && author && Content ? (
		<BlogPost {...post.data} authorProfile={author.data}>
			<Content />
		</BlogPost>
	) : (
		<>
			<html lang="en">
				<head>
					<BaseHead title="Match report not found" description="This match report could not be found." />
				</head>
				<body>
					<Header />
					<main>
						<h1>Match report not found</h1>
						<p>This report may have been removed or is still a draft.</p>
						<a href="/blog/">Back to all reports</a>
					</main>
					<Footer />
				</body>
			</html>
		</>
	)
}
